{
  "name": "aibi-c",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 8686 --strictPort",
    "api": "tsx server/index.ts",
    "build": "tsc -p tsconfig.json && vite build && node scripts/verify-bundle-budgets.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preflight": "node scripts/preflight.mjs",
    "verify": "node scripts/verify.mjs && node scripts/verify-bi-cli-agent-contract.mjs && node scripts/verify-ai-chart-reliability.mjs",
    "verify:ci": "npm run build && npm run verify && npm run verify:backup && npm run verify:production",
    "verify:ui-flow": "node scripts/verify-ui-flow.mjs",
    "verify:ui-visual": "node scripts/verify-ui-visual.mjs",
    "verify:ui-empty": "node scripts/verify-ui-empty-workspace.mjs",
    "verify:ui-import": "node scripts/verify-ui-real-import.mjs",
    "verify:ui": "node scripts/verify-ui-flow.mjs && node scripts/verify-ui-visual.mjs && node scripts/verify-ui-empty-workspace.mjs && node scripts/verify-ui-real-import.mjs",
    "verify:bi-cli-contract": "node scripts/verify-bi-cli-agent-contract.mjs",
    "verify:ai-reliability": "node scripts/verify-ai-chart-reliability.mjs",
    "verify:bundle-budgets": "node scripts/verify-bundle-budgets.mjs",
    "verify:production": "node scripts/verify-production-readiness.mjs",
    "verify:security-runtime": "node scripts/verify-server-runtime-security.mjs",
    "verify:backup": "node scripts/verify-local-backup.mjs",
    "backup:local": "node scripts/backup-local-data.mjs",
    "restore:local": "node scripts/restore-local-data.mjs",
    "verify:a-adversarial": "node scripts/verify-a-adversarial-source-intelligence.mjs",
    "verify:erp-units": "node scripts/verify-erp-unit-library.mjs",
    "verify:old-projects": "node scripts/verify-old-projects-readonly.mjs",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "local:health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-health.ps1",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3"
  }
}
