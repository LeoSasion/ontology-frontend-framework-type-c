    {"whenAny": ["missing-measure"], "requireAll": ["measure"]}
  ],
  "semanticGuards": ["no-silent-proxy", "current-context", "no-permission-escalation"],
  "compatibleContracts": ["aibi-agent-intent-frame/v1", "aibi-business-understanding-frame/v1", "aibi-semantic-context-bundle/v1"],
  "outputSchema": "aibi-business-understanding-frame/v1",
  "confirmationMode": "read-only",
  "resourceLimits": {"maxSteps": 6, "maxRows": 1}
}
