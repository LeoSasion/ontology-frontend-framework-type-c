{
  "schema": "aibi-analytical-skill/v1",
  "skillId": "metric-definition-resolution",
  "version": "1.0.0",
  "displayName": {"zh": "指标口径解析", "en": "Metric definition resolution"},
  "description": {"zh": "把比率、去重计数和业务指标还原为可验证的组成、粒度与字段绑定。", "en": "Resolve ratios, distinct counts, and business metrics into verified components, grain, and field bindings."},
  "skillKind": "understanding",
  "taskTypes": ["overview", "comparison", "trend", "composition", "ranking", "anomaly", "reconciliation", "diagnosis"],
  "requiredRoles": [],
  "requiredDomainPacks": [],
  "allowedCapabilities": ["agent.intent.resolve", "agent.context.route", "agent.semantic.plan"],
  "stepTemplate": ["classify-metric-concept", "resolve-components", "bind-fields", "confirm-grain"],
  "requiredEvidence": ["metric-definition", "field-provenance", "grain-definition"],
  "blockingRules": ["implicit-denominator", "unresolved-entity-key", "unconfirmed-business-definition"],
  "triggerSignals": ["ratio-request", "distinct-count-request", "business-term-match"],
  "slotRules": [
    {"whenAny": ["ratio-request"], "requireAll": ["metric-concept", "numerator", "denominator", "grain"]},
    {"whenAny": ["distinct-count-request"], "requireAll": ["metric-concept", "entity-key", "grain"]},
    {"whenAny": ["business-term-match"], "requireAll": ["term-definition", "field-binding", "business-rule"]}
  ],
  "semanticGuards": ["no-silent-proxy", "no-implicit-denominator", "field-provenance", "grain-explicit", "no-permission-escalation"],
  "compatibleContracts": ["aibi-agent-intent-frame/v1", "aibi-business-understanding-frame/v1", "aibi-semantic-context-bundle/v1", "aibi-semantic-query-plan/v1"],
  "outputSchema": "aibi-business-understanding-frame/v1",
  "confirmationMode": "read-only",
  "resourceLimits": {"maxSteps": 8, "maxRows": 1}
}
