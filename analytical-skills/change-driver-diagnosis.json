    {"whenAny": ["diagnosis-request"], "requireAll": ["measure", "comparison-baseline", "dimension"]},
    {"whenAny": ["time-comparison"], "requireAll": ["measure", "time-scope", "time-field", "comparison-baseline"]}
  ],
  "semanticGuards": ["time-window-complete", "facts-before-hypotheses", "receipt-before-claim", "no-permission-escalation"],
  "compatibleContracts": ["aibi-agent-intent-frame/v1", "aibi-business-understanding-frame/v1", "aibi-semantic-context-bundle/v1", "aibi-semantic-query-plan/v1", "aibi-query-plan-receipt/v1"],
  "outputSchema": "aibi-business-understanding-frame/v1",
  "confirmationMode": "read-only",
  "resourceLimits": {"maxSteps": 12, "maxRows": 500}
}
