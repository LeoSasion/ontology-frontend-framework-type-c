# Local API. Keep 8787 for the default Vite proxy and local UI checks.
AIBI_API_PORT=8787
AIBI_API_HOST=127.0.0.1

# Local safety boundaries. Remote binding is intentionally unsupported in this release.
AIBI_MAX_BODY_BYTES=1048576
AIBI_CORS_ORIGIN=

# Optional local data/runtime overrides.
AIBI_HYBRID_DB_PATH=
AIBI_HYBRID_DUCKDB_PATH=
AIBI_BACKUP_ROOT=

# Optional external Domain Pack SDK. Trust keys are a server-side JSON map: {"key-id":"secret"}.
AIBI_DOMAIN_PACK_ROOT=
AIBI_DOMAIN_PACK_TRUST_KEYS=

# Optional controlled Connector Adapter allowlists. Values are comma-separated exact origins or paths.
AIBI_HTTP_CONNECTOR_ALLOWLIST=
AIBI_SQLITE_CONNECTOR_ALLOWLIST=

# Optional Agent explanation provider. Deterministic local BI remains authoritative.
# Use deterministic by default; set deepseek explicitly after reviewing docs/extensible-domain-framework.md.
AIBI_AGENT_PROVIDER=deterministic
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=20000
DEEPSEEK_MAX_TOKENS=600
DEEPSEEK_CONTEXT_WINDOW=64000
DEEPSEEK_RETRIES=1
DEEPSEEK_PROMPT_COST_PER_MILLION=0
DEEPSEEK_COMPLETION_COST_PER_MILLION=0

# Optional explicit loopback-only OpenAI-compatible explanation endpoint.
# Remote origins are rejected; credentials remain server-side and are never persisted.
AIBI_LOCAL_PROVIDER_BASE_URL=
AIBI_LOCAL_PROVIDER_MODEL=
AIBI_LOCAL_PROVIDER_API_KEY=
AIBI_LOCAL_PROVIDER_STRUCTURED_OUTPUT=json-object
AIBI_LOCAL_PROVIDER_CONTEXT_WINDOW=32768
AIBI_LOCAL_PROVIDER_TIMEOUT_MS=20000
AIBI_LOCAL_PROVIDER_MAX_TOKENS=600
AIBI_LOCAL_PROVIDER_RETRIES=1

# UI verification defaults. Override only when running services elsewhere.
AIBI_UI_BASE_URL=http://127.0.0.1:8686
AIBI_API_BASE_URL=http://127.0.0.1:8787
AIBI_CHROME_PATH=
AIBI_REAL_IMPORT_FOLDER=
AIBI_REAL_IMPORT_FILE=
